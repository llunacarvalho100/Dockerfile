# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Diretório persistente para produtos_postados.json (volume Railway/Render/Docker)
DATA_DIR="./data"

# Credenciais Shopee Affiliate Open API (Painel de Afiliados Shopee)
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""

# Telegram Bot API (Disparo do pacote operacional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
